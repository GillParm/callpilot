# Copy this file to .env and fill in what you have. .env is gitignored: never commit it.

# ---------------------------------------------------------------------------
# Model providers. Set at least one key.
# ---------------------------------------------------------------------------
# Real-time voice. OpenAI Realtime is the default; Gemini Live has a free tier
# (create a key at https://aistudio.google.com/apikey).
OPENAI_API_KEY=
GEMINI_API_KEY=

# Text mode, call summaries and the live simulated-caller test.
ANTHROPIC_API_KEY=

# Which provider handles each mode. "auto" picks the first one with a key:
# voice: openai, then gemini. text: anthropic, then openai.
VOICE_PROVIDER=auto
TEXT_PROVIDER=auto
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. Receptionist turns are short, so low keeps them snappy.
ANTHROPIC_EFFORT=low

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
CALLPILOT_ENV=development
LOG_LEVEL=INFO
DATABASE_PATH=data/callpilot.db
CLINIC_TIMEZONE=America/Toronto
# JSON list of origins allowed to call the API from a browser.
CORS_ORIGINS=["http://localhost:3000"]

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# URL the browser uses to reach the backend (HTTP and WebSocket).
BACKEND_PUBLIC_URL=http://localhost:8000
# URL the Next.js server uses to reach the backend (inside docker compose).
BACKEND_INTERNAL_URL=http://localhost:8000
